---
import { getCollection, render } from "astro:content";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE } from "../consts";
import { withBase } from "../lib/site-paths";
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Labels for the build-recipe snippets. The code itself is rendered straight
 * from `src/content/snippets/*.md` — nothing is duplicated here, and the copy
 * button reads the rendered code from the DOM.
 */
const SNIPPET_TABS = [
  { id: "install", label: "ZON install", language: "zon" },
  { id: "openharmony", label: "OpenHarmony", language: "zig" },
  { id: "node", label: "Node addon", language: "zig" },
  { id: "types", label: "Type definitions", language: "zig" },
];

const capabilities = [
  {
    title: "Dual runtime output",
    body: "Use one Zig export surface to build OpenHarmony shared libraries and Node.js addons.",
  },
  {
    title: "Typed JavaScript boundary",
    body: "Generate declaration files from functions, classes, enums, async descriptors, structs, and unions.",
  },
  {
    title: "N-API version gates",
    body: "Select Node-API v4 through v10 behavior and fail early when wrappers need a newer runtime API.",
  },
  {
    title: "Low-level escape hatches",
    body: "Work directly with Object, String, Buffer, ArrayBuffer, TypedArray, DataView, External, and references.",
  },
];

const surfaces = [
  ["OpenHarmony", "aarch64-linux-ohos, arm-linux-ohoseabi, x86_64-linux-ohos"],
  ["Node.js", "host target by default, with platform-specific .node output names"],
  ["TypeScript", "index.d.ts generation from the same addon root"],
  ["Examples", "basic, init, node, allocator, memory, and benchmark fixtures"],
];

const commands = ["zig fetch", "zig build", "zig build -Dtarget=aarch64-linux-ohos"];

const snippetEntries = new Map((await getCollection("snippets")).map((entry) => [entry.id, entry]));

const snippets = [];
for (const tab of SNIPPET_TABS) {
  const entry = snippetEntries.get(tab.id);
  if (!entry) continue;
  const { Content } = await render(entry);
  snippets.push({ ...tab, Content });
}
---

<BaseLayout title={`${SITE.name} · ${SITE.category}`} description={SITE.description}>
  <SiteHeader section="home" />
  <main id="main" tabindex="-1" class="page">
    <span id="top"></span>
    <header class="hero">
      <p class="eyebrow">{SITE.category}</p>
      <h1>{SITE.name}</h1>
      <p class="tagline">
        Build N-API modules with Zig, ship OpenHarmony artifacts, compile Node.js addons, and
        generate TypeScript declarations from the same exported surface.
      </p>
      <ul class="hero-tokens">
        <li>
          <b>Zig 0.16+</b> minimum toolchain
        </li>
        <li>
          <b>Node-API v4&ndash;v10</b> gated wrappers
        </li>
        <li>
          <b>{SITE.license}</b> licensed
        </li>
      </ul>
      <div class="hero-cta">
        <a class="btn-ghost" href={withBase("api/")}>
          API Reference
        </a>
        <a class="btn-primary" href="#install">
          Start with ZON
        </a>
      </div>
    </header>

    <section class="section">
      <div class="section-head">
        <p class="section-num">00 &middot; Build pipeline</p>
      </div>
      <figure class="figure">
        <div class="figure-frame">
          <img
            src={withBase("zig-napi-pipeline.svg")}
            alt="Zig source flowing through zig-napi into OpenHarmony libraries, Node addons, and TypeScript definitions"
            width="960"
            height="520"
          />
        </div>
        <figcaption>
          One addon root produces the OpenHarmony shared library, the Node.js addon, and the
          matching TypeScript declarations.
        </figcaption>
      </figure>
    </section>

    <section class="section">
      <div class="section-head">
        <p class="section-num">01 &middot; Capability map</p>
        <h2 class="section-title">One addon surface, multiple outputs</h2>
      </div>
      <ol class="features">
        {capabilities.map((item) => (
          <li>
            <p class="name">{item.title}</p>
            <p class="what">{item.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="install">
      <div class="section-head">
        <p class="section-num">02 &middot; Setup</p>
        <h2 class="section-title">Install as a Zig package</h2>
        <p class="section-lede">
          The package exports both the <code>napi</code> module and the <code>napi_build</code>
          {" helpers used by examples in this repository."}
        </p>
      </div>
      <ul class="command-lines" aria-label="Setup commands">
        {commands.map((command) => (
          <li>
            <code>{command}</code>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="build">
      <div class="snippets" data-snippets>
        <div class="snippets-head">
          <div class="section-head">
            <p class="section-num">03 &middot; Build recipes</p>
            <h2 class="section-title">Copy the shape that matches your target</h2>
          </div>
          <div class="snippet-tabs" data-snippets-tabs aria-label="Build recipe snippets">
            {snippets.map((snippet) => (
              <a
                class="snippet-tab"
                id={`build-tab-${snippet.id}`}
                href={`#build-${snippet.id}`}
                data-snippet-tab={snippet.id}
                aria-controls={`build-${snippet.id}`}
              >
                {snippet.label}
              </a>
            ))}
          </div>
        </div>
        {snippets.map((snippet) => {
          const Panel = snippet.Content;
          return (
            <section
              class="snippet-panel"
              id={`build-${snippet.id}`}
              data-snippet-panel={snippet.id}
              aria-labelledby={`build-tab-${snippet.id}`}
            >
              <div class="snippet-panel-head">
                <h3 class="snippet-title">{snippet.label}</h3>
                <div class="snippet-actions">
                  <span class="snippet-label">{snippet.language}</span>
                  {/* Revealed by the enhancement script; without JavaScript the
                        button would not be able to copy anything. */}
                  <button
                    class="copy-button"
                    type="button"
                    data-snippet-copy
                    aria-label={`Copy the ${snippet.label} snippet`}
                    hidden
                  >
                    Copy
                  </button>
                </div>
              </div>
              <Panel />
              <p class="snippet-status" role="status" aria-live="polite" data-snippet-status />
            </section>
          );
        })}
      </div>
    </section>

    <section class="section" id="types">
      <div class="section-head">
        <p class="section-num">04 &middot; Type generation</p>
        <h2 class="section-title">TypeScript declarations stay close to Zig exports</h2>
      </div>
      <ul class="features">
        <li>
          <p class="name">Generated from Zig</p>
          <p class="what">
            Functions, classes, tuples, structs, enums, arrays, unions, async descriptors, and raw
            N-API wrappers are mapped into declaration files during the build.
          </p>
        </li>
        <li>
          <p class="name">Override when the public contract differs</p>
          <p class="what">
            <code>napi.dts(value, "TypeScriptType")</code> and{" "}
            <code>napi.Dts(T, "TypeScriptType")</code> let exported declarations express a custom
            TypeScript-facing contract while keeping runtime values unchanged.
          </p>
        </li>
      </ul>
    </section>

    <section class="section">
      <div class="section-head">
        <p class="section-num">05 &middot; Targets</p>
        <h2 class="section-title">Build surface</h2>
      </div>
      <div class="table-scroll">
        <table class="surface-table">
          <caption class="visually-hidden">Targets and what they produce</caption>
          <thead>
            <tr>
              <th scope="col">Target</th>
              <th scope="col">Detail</th>
            </tr>
          </thead>
          <tbody>
            {surfaces.map(([name, detail]) => (
              <tr>
                <th scope="row">{name}</th>
                <td>{detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <p class="section-num">06 &middot; Reference</p>
        <h2 class="section-title">API docs live on their own path</h2>
        <p class="section-lede">
          The standalone API reference covers module registration, build helpers, runtime values,
          binary wrappers, async descriptors, native ownership, errors, and custom TypeScript
          declaration overrides.
        </p>
      </div>
      <p class="section-lede">
        Use the API page when you need exact Zig signatures and wrapper behavior instead of the
        overview flow.
      </p>
      <p>
        <a class="btn-primary" href={withBase("api/")}>
          Open API Reference
        </a>
      </p>
    </section>
  </main>
  <SiteFooter />
  <script>
    import { initSnippets } from "../scripts/snippets";

    initSnippets();
  </script>
</BaseLayout>
