---
import { getCollection, render, type CollectionEntry } from "astro:content";

import { getApiDoc } from "../../data/api-docs";
import DocsLayout from "../../layouts/DocsLayout.astro";

type Props = { entry: CollectionEntry<"api"> };

export async function getStaticPaths() {
  const entries = await getCollection("api");

  return entries
    .filter((entry) => entry.id !== "overview")
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as Props;
const doc = getApiDoc(entry.id);
const { Content, headings } = await render(entry);
---

<DocsLayout doc={doc} title={entry.data.title} headings={headings}>
  <Content />
</DocsLayout>
